# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Firebase Admin Service Account JSON for Custom Claims syncing on Express backend
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# Optional SMTP settings for live email dispatch
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="support@noorstudio.pk"
