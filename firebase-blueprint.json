{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Product document for NOOR STUDIO women's fashion store",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 200 },
        "slug": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 5000 },
        "category": { "type": "string", "maxLength": 100 },
        "subcategory": { "type": "string", "maxLength": 100 },
        "fabric": { "type": "string", "maxLength": 100 },
        "regularPrice": { "type": "number" },
        "salePrice": { "type": "number" },
        "sku": { "type": "string", "maxLength": 50 },
        "colors": {
          "type": "array",
          "description": "Color variants with individual image galleries and size stock"
        },
        "defaultColor": { "type": "string", "maxLength": 50 },
        "isNewArrival": { "type": "boolean" },
        "isBestSeller": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "category", "regularPrice", "colors", "isActive"]
    },
    "Category": {
      "title": "Category",
      "description": "Category document with subcategories for navigation and filtering",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "slug": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 1000 },
        "image": { "type": "string", "maxLength": 2000 },
        "subcategories": { "type": "array" },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["name", "slug", "isActive"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order document",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string", "maxLength": 50 },
        "userId": { "type": "string", "maxLength": 128 },
        "isGuest": { "type": "boolean" },
        "customer": { "type": "object" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "shippingCost": { "type": "number" },
        "discount": { "type": "number" },
        "couponCode": { "type": "string", "maxLength": 50 },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "paymentStatus": { "type": "string", "maxLength": 50 },
        "orderStatus": { "type": "string", "maxLength": 50 },
        "trackingNumber": { "type": "string", "maxLength": 100 },
        "courier": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["orderNumber", "customer", "items", "subtotal", "total", "paymentMethod", "orderStatus"]
    },
    "Cart": {
      "title": "Cart",
      "description": "Customer saved shopping cart",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "items": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "items"]
    },
    "Wishlist": {
      "title": "Wishlist",
      "description": "Customer wishlist items",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "productIds": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "productIds"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Store branding and configuration settings",
      "type": "object",
      "properties": {
        "brandName": { "type": "string", "maxLength": 100 },
        "helpline": { "type": "string", "maxLength": 50 },
        "whatsapp": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 100 },
        "websiteUrl": { "type": "string", "maxLength": 200 },
        "shippingFee": { "type": "number" },
        "freeShippingThreshold": { "type": "number" },
        "announcement": { "type": "string", "maxLength": 500 }
      },
      "required": ["brandName", "helpline", "whatsapp", "email"]
    },
    "Review": {
      "title": "Review",
      "description": "Product customer review",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 2000 },
        "verifiedBuyer": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["productId", "authorName", "rating", "comment"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Designated administrator UID record",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Published women fashion products with color variants"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Product categories and subcategories"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders placed online or via COD"
    },
    "/carts/{userId}": {
      "schema": { "$ref": "#/entities/Cart" },
      "description": "User persistent shopping cart"
    },
    "/wishlists/{userId}": {
      "schema": { "$ref": "#/entities/Wishlist" },
      "description": "User saved wishlist items"
    },
    "/store_settings/{settingId}": {
      "schema": { "$ref": "#/entities/StoreSettings" },
      "description": "Store operational settings and contact info"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Product customer ratings and reviews"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Administrator authorizations"
    }
  }
}
